{
	"name": "mimi-ui",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"description": "The MIMI app — Machine Intelligence, Minus the Internet",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:demo": "node demo/build.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run --silent contrast",
		"contrast": "node --disable-warning=ExperimentalWarning scripts/contrast.mjs",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:demo": "playwright test -c e2e-demo/playwright.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@lucide/svelte": "^1.62.0",
		"@protomaps/basemaps": "^5.7.2",
		"dompurify": "^3.4.17",
		"maplibre-gl": "^6.16.0",
		"marked": "^18.1.2",
		"pmtiles": "^4.5.0"
	}
}
