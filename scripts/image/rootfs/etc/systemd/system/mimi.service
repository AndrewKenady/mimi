[Unit]
Description=Mimi Core
Documentation=https://github.com/AndrewKenady/mimi/blob/main/docs/INSTALL.md#bootable-usb
After=network.target

[Service]
User=mimi
Group=mimi
# render/video: the GPU for llama.cpp's Vulkan build; dialout: a USB GPS.
SupplementaryGroups=render video dialout
Environment=MIMI_HOME=/opt/mimi
Environment=MIMI_CONTENT=/var/lib/mimi/content
Environment=MIMI_DATA=/var/lib/mimi/data
Environment=MIMI_LOGS=/var/lib/mimi/logs
Environment=PYTHONUNBUFFERED=1
# Listens on 127.0.0.1:7600 only. Sharing (Settings > Share) is off until the owner
# turns it on; then the share server uses ports 443 and 80, which needs this one capability.
ExecStart=/opt/mimi/python/bin/mimi serve
Restart=always
RestartSec=5
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mimi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
