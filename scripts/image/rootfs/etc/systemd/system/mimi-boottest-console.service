[Unit]
Description=Boot test: copy the journal to the serial port
ConditionCredential=mimi.boottest
After=systemd-journald.service

[Service]
ExecStart=/usr/bin/journalctl --boot --follow --lines=all --output=short-monotonic --no-hostname
StandardInput=null
StandardOutput=tty
TTYPath=/dev/ttyS0

[Install]
WantedBy=multi-user.target
