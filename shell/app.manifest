<?xml version="1.0" encoding="utf-8"?>
<!--
  Application manifest for MIMI.exe (embedded by build.ps1 via csc /win32manifest).
  - Per-Monitor V2 DPI awareness: crisp text on the handheld's high-DPI panel and on external
    monitors; WebView2 follows each monitor's scale on its own.
  - asInvoker: MIMI never needs elevation.
  - Windows 10/11 compatibility GUID so the OS doesn't apply legacy shims.
  - Common Controls v6 so message boxes shown before WinForms starts are themed too.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.1.0.0" processorArchitecture="amd64" name="MIMI.Shell" type="win32" />
  <description>MIMI - Machine Intelligence, Minus the Internet</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Older Windows 10 builds read dpiAware; newer ones prefer dpiAwareness. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
